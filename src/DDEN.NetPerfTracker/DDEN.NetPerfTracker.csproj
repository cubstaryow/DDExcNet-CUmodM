<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DDEN.NetPerfTracker</AssemblyName>
    <RootNamespace>DDEN.NetPerfTracker</RootNamespace>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDEN.Shared\DDEN.Shared.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DdenPluginsDir)" />
  </Target>

  <ItemGroup><EmbeddedResource Include="Resources\localization.en.json"><WithCulture>false</WithCulture></EmbeddedResource></ItemGroup>
</Project>
