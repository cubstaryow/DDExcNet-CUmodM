<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AssemblyName>ET-HeatingCageFix</AssemblyName><RootNamespace>HeatingCageFix</RootNamespace><Version>$(DdenVersion)</Version></PropertyGroup>
  <ItemGroup>
    <Reference Remove="CUCoreLib" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DdenPluginsDir)" />
    <Delete Files="$(DdenPluginsDir)\CageFix.dll" Condition="Exists('$(DdenPluginsDir)\CageFix.dll')" />
  </Target>
</Project>
