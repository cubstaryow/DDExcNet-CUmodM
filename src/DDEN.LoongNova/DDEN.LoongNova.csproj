<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DDEN.LoongNova</AssemblyName>
    <RootNamespace>DDEN.LoongNova</RootNamespace>
    <Version>1.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DDEN.Shared/DDEN.Shared.csproj" />
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <EmbeddedResource Include="Content.json" />
    <EmbeddedResource Include="images/*.png" Exclude="images/dragon-wing-back-side.png;images/gravity-belt.png;images/dragon-wing-back.png;images/dragon-wing-waist.png" />
  </ItemGroup>
</Project>
