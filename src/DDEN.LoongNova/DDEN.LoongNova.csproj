<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DDEN.LoongNova</AssemblyName>
    <RootNamespace>DDEN.LoongNova</RootNamespace>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DDEN.Shared/DDEN.Shared.csproj" />
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)/UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <EmbeddedResource Include="Locales/*.json" WithCulture="false" />
    <EmbeddedResource Include="images/*.png" />
  </ItemGroup>
</Project>
