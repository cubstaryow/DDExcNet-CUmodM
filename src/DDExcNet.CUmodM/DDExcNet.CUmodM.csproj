<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DDExcNet-CUmodM</AssemblyName>
    <RootNamespace>DDExcNet.CUmodM</RootNamespace>
    <Version>2.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDEN.Shared\DDEN.Shared.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- 图标与「关于」页文本等内嵌资源（打进 dll，运行时按资源名读出）
       注意：这些属于「资源」，不适用根目录 LICENSE（MPL-2.0），见 LICENSE-ASSETS -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
    <EmbeddedResource Include="Resources\*.txt" />
    <EmbeddedResource Update="Resources\*.txt"><WithCulture>false</WithCulture></EmbeddedResource>
  </ItemGroup>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DdenPluginsDir)" />
  </Target>

</Project>
