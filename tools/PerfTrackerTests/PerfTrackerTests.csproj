<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Unity-facing code fills the other fields; this project intentionally links only the pure data model. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Update="BepInEx;Newtonsoft.Json;UnityEngine;UnityEngine.CoreModule"><Private>true</Private></Reference>
    <Compile Include="../../src/DDEN.Shared/DdenLocalization.cs" Link="DdenLocalization.cs" />
    <Compile Include="../../src/DDEN.NetPerfTracker/ModuleText.cs" Link="ModuleText.cs" />
    <EmbeddedResource Include="../../src/DDEN.NetPerfTracker/Resources/localization.en.json" LogicalName="DDEN.NetPerfTracker.Resources.localization.en.json"><WithCulture>false</WithCulture></EmbeddedResource>
    <Compile Include="../../src/DDEN.NetPerfTracker/PerfData.cs" Link="PerfData.cs" />
    <Compile Include="../../src/DDEN.NetPerfTracker/PerfAlerts.cs" Link="PerfAlerts.cs" />
    <Compile Include="../../src/DDEN.NetPerfTracker/PerfLog.cs" Link="PerfLog.cs" />
  </ItemGroup>
</Project>
